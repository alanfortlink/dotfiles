#!/usr/bin/env bash
# ALT+W handler: if the active window hosts herdr/tmux (local or via ssh),
# close the focused *pane* (the mux handles the last pane -> tab/workspace;
# tmux asks first when the pane is running something other than a shell);
# otherwise close the Hyprland window.
set -u
source "$(dirname "$(readlink -f "$0")")/hypr-mux-lib.sh"

if hh_resolve_targets; then
  for entry in "${HH_TARGETS[@]}"; do
    read -r kind host client <<<"$entry"
    if [[ $kind == herdr || $kind == any ]]; then
      pane_id=$(hh "$host" pane current --current 2>/dev/null | jq -r '.result.pane.pane_id // empty')
      if [[ -n $pane_id ]]; then
        hh "$host" pane close "$pane_id"; exit
      fi
    fi
    if [[ $kind == tmux || $kind == any ]]; then
      c=$(ht_client "$host" "${client:-}") || continue
      pane_id=$(ht_pane "$host" "$c")
      if [[ -n $pane_id ]]; then
        ht_kill_pane "$host" "$c" "$pane_id"; exit
      fi
    fi
  done
fi

exec hyprctl dispatch 'hl.dsp.window.close()'
