#!/usr/bin/env bash
# ALT+Z handler: inside herdr (local or via ssh) with >1 pane in the tab,
# toggle pane zoom; otherwise toggle Hyprland maximize.
set -u
source "$(dirname "$(readlink -f "$0")")/hypr-herdr-lib.sh"

if hh_resolve_targets; then
  for t in "${HH_TARGETS[@]}"; do
    n=$(hh "$t" pane layout --current 2>/dev/null | jq -r '.result.layout.panes | length')
    if [[ ${n:-0} -gt 1 ]]; then
      hh "$t" pane zoom --toggle --current; exit
    fi
  done
fi

exec hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "maximized" })'
