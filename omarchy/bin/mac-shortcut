#!/bin/bash
# Translate an Alt+<token> press into the right Ctrl(+Shift)+<key> for the
# focused window. Per-(app, token) routing table below.
# Token examples: N, T, W, R, L, C, V, Shift+T, 0..9
arg="$1"
shift
class=$(hyprctl activewindow -j | jq -r '.class // ""')
# Chromium is Chrome under the hood -> route its shortcuts identically.
case "$class" in chromium|Chromium|chromium-browser) class=google-chrome ;; esac
echo "$(date +%H:%M:%S) class=$class arg=$arg" >> /tmp/mac-shortcut.log

is_terminal() {
  case "$1" in
    com.mitchellh.ghostty|Alacritty|kitty|foot|WezTerm|wezterm|org.wezfurlong.wezterm) return 0 ;;
    *) return 1 ;;
  esac
}

# Inject via wtype, releasing the physically-held Alt first: sendshortcut
# fired from an exec bind leaks the held Alt into the combo, so Chrome saw
# Ctrl+Alt+N and ignored it (same trick as the reopen-tab bind).
send() {
  local key
  key=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
  case "$1" in
    "CTRL")       wtype -m alt -M ctrl -k "$key" -m ctrl ;;
    "CTRL SHIFT") wtype -m alt -M ctrl -M shift -k "$key" -m shift -m ctrl ;;
    "SHIFT")      wtype -m alt -M shift -k "$key" -m shift ;;
    *)            hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"$1\", key = \"$2\" })" ;;
  esac
}
# Hyprland 0.56: hyprctl dispatch args are lua, legacy dispatcher names fail.
fallback() {
  case "${1:-}" in
    "") ;;
    killactive) hyprctl dispatch "hl.dsp.window.close()" ;;
    *) hyprctl dispatch "$@" ;;
  esac
}

case "$class:$arg" in
  google-chrome:N|google-chrome:T|google-chrome:W|google-chrome:R|google-chrome:L|\
  google-chrome:0|google-chrome:1|google-chrome:2|google-chrome:3|google-chrome:4|\
  google-chrome:5|google-chrome:6|google-chrome:7|google-chrome:8|google-chrome:9)
    send "CTRL" "$arg" ;;
  google-chrome:Shift+T)
    send "CTRL SHIFT" "T" ;;
  com.mitchellh.ghostty:W)
    send "CTRL" "W" ;;
  com.mitchellh.ghostty:N|com.mitchellh.ghostty:T)
    send "CTRL SHIFT" "$arg" ;;
  *)
    case "$arg" in
      C|V|X)
        if is_terminal "$class"; then
          if [ "$arg" = "V" ] && wl-paste --list-types 2>/dev/null | grep -qi '^image/'; then
            send "CTRL" "V"
          else
            send "CTRL SHIFT" "$arg"
          fi
        else
          send "CTRL" "$arg"
        fi
        ;;
      *)
        fallback "$@" ;;
    esac
    ;;
esac
