#!/usr/bin/env bash
# Seamless directional focus across herdr/tmux panes (local or via ssh) and
# Hyprland windows.  Usage: hypr-mux-focus <l|r|u|d>
set -u
source "$(dirname "$(readlink -f "$0")")/hypr-mux-lib.sh"
dir=$1
case $dir in
  l) hdir=left  tflag=L edge=pane_at_left ;;
  r) hdir=right tflag=R edge=pane_at_right ;;
  u) hdir=up    tflag=U edge=pane_at_top ;;
  d) hdir=down  tflag=D edge=pane_at_bottom ;;
  *) echo "usage: $0 <l|r|u|d>" >&2; exit 2 ;;
esac

if hh_resolve_targets; then
  for entry in "${HH_TARGETS[@]}"; do
    read -r kind host client <<<"$entry"
    if [[ $kind == herdr || $kind == any ]]; then
      neighbor=$(hh "$host" pane neighbor --direction "$hdir" --current 2>/dev/null \
        | jq -r '.result.neighbor.neighbor_pane_id // empty')
      if [[ -n $neighbor ]]; then
        hh "$host" pane focus --direction "$hdir" --current; exit
      fi
    fi
    if [[ $kind == tmux || $kind == any ]]; then
      c=$(ht_client "$host" "${client:-}") || continue
      at_edge=$(ht "$host" display-message -c "$c" -p "#{$edge}" 2>/dev/null)
      if [[ $at_edge == 0 ]]; then
        ht "$host" select-pane "-$tflag" -t "$(ht_pane "$host" "$c")"; exit
      fi
    fi
  done
fi

exec hyprctl dispatch "hl.dsp.focus({ direction = \"$dir\" })"
