#!/usr/bin/env bash
# Seamless directional focus across Herdr panes (local or via ssh) and
# Hyprland windows.  Usage: hypr-herdr-focus <l|r|u|d>
set -u
source "$(dirname "$(readlink -f "$0")")/hypr-herdr-lib.sh"
dir=$1
case $dir in
  l) hdir=left ;; r) hdir=right ;; u) hdir=up ;; d) hdir=down ;;
  *) echo "usage: $0 <l|r|u|d>" >&2; exit 2 ;;
esac

if hh_resolve_targets; then
  for t in "${HH_TARGETS[@]}"; do
    neighbor=$(hh "$t" pane neighbor --direction "$hdir" --current 2>/dev/null \
      | jq -r '.result.neighbor.neighbor_pane_id // empty')
    if [[ -n $neighbor ]]; then
      hh "$t" pane focus --direction "$hdir" --current; exit
    fi
  done
fi

exec hyprctl dispatch "hl.dsp.focus({ direction = \"$dir\" })"
