# Dynamic theme colors from omarchy (overrides hardcoded theme below)
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

font-family = PragmataPro Mono Liga
font-style = Regular
font-thicken = true
font-size = 12

background = "#000000"
background-opacity = 0.97
background-blur-radius = 100
macos-titlebar-style = tabs
theme = "3024 Night"

copy-on-select = false

# All opt+/M- pane and split bindings are owned by tmux (see ~/.tmux.conf).
# Only non-conflicting clipboard binds remain here.
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u

# --- Copy/scroll mode ---
# super+u / super+d enter the "copy" key table and scroll one page.
keybind = super+u=activate_key_table:copy
keybind = chain=scroll_page_up
keybind = super+d=activate_key_table:copy
keybind = chain=scroll_page_down

# Inside copy mode: scroll/navigate, extend an existing selection, copy, exit.
keybind = copy/u=scroll_page_up
keybind = copy/d=scroll_page_down
keybind = copy/g=scroll_to_top
keybind = copy/shift+g=scroll_to_bottom
# Selection: v starts/extends a selection; hjkl adjust it.
# (ghostty has no scrollback cursor, so v alone may be a no-op without
#  an existing selection — extend with hjkl after starting a mouse drag,
#  or use shift+arrow which works the same way.)
keybind = copy/v=adjust_selection:right
keybind = copy/h=adjust_selection:left
keybind = copy/j=adjust_selection:down
keybind = copy/k=adjust_selection:up
keybind = copy/l=adjust_selection:right
keybind = copy/y=copy_to_clipboard
keybind = chain=deactivate_key_table
keybind = copy/escape=deactivate_key_table
keybind = copy/q=deactivate_key_table

window-save-state = "always"
shell-integration = "bash"
confirm-close-surface = false

# herdr/tmux direct layer (~/.config/herdr/config.toml, ~/.config/tmux/tmux.conf):
# let these reach the multiplexer instead of ghostty. Ghostty tabs are unused;
# ALT+T is routed to ctrl+shift+t (hypr bindings.lua) for a mux tab.
keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+p=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
# Legacy encoding sends ctrl+1..9 as a bare digit; send CSI-u so the mux can
# bind them (herdr/tmux switch tab N). Apps in panes see the same CSI-u.
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u
